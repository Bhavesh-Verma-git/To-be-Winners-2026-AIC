# =====================================================================
#  ControlPlane.ai environment  -  copy to  controlplane/.env  and fill in
#  (controlplane/.env is gitignored; this .example file is the template)
# =====================================================================

# ---- LLM provider key pools (comma-separated; 3-4 of each) ----
GROQ_API_KEYS=gsk_xxx1,gsk_xxx2,gsk_xxx3
GEMINI_API_KEYS=AIzaSyXXX1,AIzaSyXXX2          # Google AI Studio keys start with "AIza"
# single-key aliases also accepted: GROQ_API_KEY / GOOGLE_API_KEY

# ---- LiteLLM model catalog (optional overrides; comma-separated, priority order) ----
# CP_MODEL_LIGHT=groq/openai/gpt-oss-20b,gemini/gemini-2.0-flash
# CP_MODEL_MEDIUM=groq/openai/gpt-oss-120b,gemini/gemini-2.5-flash
# CP_MODEL_HEAVY=groq/llama-3.3-70b-versatile,gemini/gemini-2.5-pro
# CP_MODEL_JUDGE=groq/openai/gpt-oss-20b,gemini/gemini-2.0-flash
# CP_MODEL_MAIN_AGENT=groq/openai/gpt-oss-120b,gemini/gemini-2.5-flash
# CP_MODEL_SUGGESTION=groq/openai/gpt-oss-20b
# CP_MODEL_RESPONSIBILITY=gemini/gemini-2.5-flash,groq/openai/gpt-oss-120b
# per-KB answer model category: CP_KB_MODEL_DECISION_SUPPORT=heavy   (etc.)

CP_LITELLM_RETRIES=2
CP_LITELLM_TIMEOUT=20
CP_MAX_TOKENS=1024
# CP_LLM_MOCK=1                              # force deterministic mock (auto-on when no keys)

# ---- LangSmith ----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=controlplane

# ---- Neo4j (Responsibility knowledge graph; optional - cached triples fallback exists) ----
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io   # self-hosted w/ self-signed cert? use neo4j+ssc://
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j
# CP_NEO4J_DISABLE=1                         # skip Neo4j entirely

# ---- thresholds (all optional) ----
CP_CACHE_THRESHOLD=0.83
CP_CACHE_ENABLED=true
# CP_CACHE_PERSIST=1                         # persist cache to disk across restarts (default: in-memory)
CP_GUARD_SIM=0.78
CP_RRF_C=60
CP_XGB_MAX_SENTS=0                           # per-sentence NLI cap; 0 = whole-text only (fast)
# CP_NLI_MODEL=roberta-large-mnli            # default cross-encoder/nli-distilroberta-base (fast)
CP_XGB_THRESH=0.60
CP_TOX_HARD=0.70
CP_TOX_SOFT=0.40
CP_PERF_BUDGET_S=8
CP_RESP_BUDGET_S=8
CP_RETRY_DEADLINE_S=7                        # max elapsed before a self-reflection EDIT retry is allowed
CP_RAGAS_TIMEOUT_S=3.8                       # judge-call timeout; falls back to the lexical heuristic
CP_STREAM_CAP_S=7                            # hard wall-clock cap on a streamed answer (protects <10s)
CP_ROUTER_KEYWORD_SKIP=0.62
CP_ROUTER_SEM_MIN=0.30                       # min query<->KB similarity for the semantic router probe
CP_ROUTER_SEM_MARGIN=0.06
# CP_DEBUG=1                                 # print [cp:router] / [cp:retrieval] / [cp:performance] / [cp:responsibility] / [cp:aggregate] trace lines
# CP_GEMINI_ALLOW_ANY=1                      # register non-AIza Gemini keys (default: only AIza... keys)
CP_EMBED_DEVICE=cpu
# CP_HF_ONLINE=1                             # allow HF downloads at runtime (first setup)
# CP_DETOXIFY_ALLOW_DOWNLOAD=1
